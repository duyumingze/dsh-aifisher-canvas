{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "lib",
    "rootDir": ".",
    "declaration": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/canvas-ui/*"],
      "three": ["./src/client/canvas/stubs/three.ts"],
      "@react-three/fiber": ["./src/client/canvas/stubs/react-three-fiber.tsx"],
      "@react-three/drei": ["./src/client/canvas/stubs/react-three-drei.tsx"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib"]
}
